# The instance layer lives OUTSIDE this repo. These guards ensure real instance
# data never gets committed even if someone points instancePath into the repo
# tree or copies the example in place. The example TEMPLATES stay tracked.

# Instance data (never commit)
config.json
state.json

# Common instance-folder names
_decoder/
instance/

# OS cruft / editor / FUSE leftovers
.DS_Store
.fuse_hidden*
__pycache__/

# Keep the templates tracked (they carry no real data)
!config/*.example.json

# browser-tool artifacts: a screenshot of a real board is instance data
.playwright-mcp/
